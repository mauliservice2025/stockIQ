# ============================================================================
# STOCKIQ ENTERPRISE - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed for your environment.
# ============================================================================

# Backend API Endpoint
API_BASE_URL=http://localhost:3001/api/v1

# Application Branding
APP_TITLE=StockIQ Enterprise

# Default Organization & Branch Context
DEFAULT_FACILITY_ID=PLANT-01

# Default UI Theme (dark | light)
DEFAULT_THEME=dark

# Angular Dev Server Port
PORT=4200

# Capacitor Live Reload URL (Used when testing on Android emulator / physical device)
CAPACITOR_SERVER_URL=http://localhost:4200
