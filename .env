# ============================================================================
# STOCKIQ ENTERPRISE - ENVIRONMENT CONFIGURATION
# ============================================================================

# Web Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection Credentials (BRD Section 39)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockiq

# Individual parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=stockiq
PGUSER=postgres
PGPASSWORD=postgres

# PostgreSQL Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
