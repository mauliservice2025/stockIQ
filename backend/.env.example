# ============================================================================
# STOCKIQ ENTERPRISE - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed for your environment.
# ============================================================================

# HTTP Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockiq
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=stockiq

# Database Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# Authentication & Security (JWT)
JWT_SECRET=super-secret-development-key-change-in-production
JWT_EXPIRES_IN=8h

# CORS Allowed Origins (Comma-separated: web dev server, Capacitor app schemes)
CORS_ORIGIN=http://localhost:4200,capacitor://localhost,http://localhost

# Structured Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
